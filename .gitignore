# Sly-2-Recomp -- the title module for NativeEE. Nothing game-derived is ever committed here.

# build directories (build.sh defaults to the sibling ../<checkout name>-build; these cover an in-tree slip)
/build/
/build-*/
/out/
/generated/
/dist/

# recompiled code / extracted inputs, wherever a title directory might receive a developer copy
# (the build writes them under <build>/generated/, never here)
/games/*/recomp/recompiled.h
/games/*/recomp/recompiled.cpp
/games/*/recomp/recompiled_shard_*.cpp
/games/*/recomp/continuations.h
/games/*/recomp/cwd/
/games/*/recomp/logs/
/games/*/recomp/tool_cwd/
/games/*/iop/*/iop_recompiled.h
/games/*/iop/*/iop_recompiled.cpp
recompiled_shard_*.cpp
iop_recompiled.cpp
/games/*/triage/*
!/games/*/triage/README.md

# harness legs / play sessions run inside the tree
/legs/
/verify/legs/
/verify/out/
/play_sessions/
/logs/

# CI run products (the guard job's reports, the collected build logs) -- never committed
/asset_scan_*.md
/ci-logs/
/engine_status.txt

# python / editors / OS
__pycache__/
*.pyc
.DS_Store
*.swp
.vscode/
.idea/
compile_commands.json

